<Window x:Class="CalculatorWPF.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CalculatorWPF.Converters"
        xmlns:views="clr-namespace:CalculatorWPF.Views"
        mc:Ignorable="d"
        Title="حاسبة الضرب التتابعي - المحاسب الذكي" 
        Icon="/app_icon.png"
        Height="700" Width="1100"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Cairo, Segoe UI, Tahoma">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Window Control Button Base Style -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style (Red on hover) -->
        <Style x:Key="CloseControlButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Navigation Tab Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="0,0,0,0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Input Box Style -->
        <Style x:Key="HeroTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputFocusedBorderBrush}"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" Color="#0A84FF" Opacity="0.3" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Modern Input Style -->
        <Style x:Key="ModernInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputFocusedBorderBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Custom Compact DataGrid Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridSelectedRowBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridRowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DataGridSelectedRowBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Settings Sidebar Button Style -->
        <Style x:Key="SettingsSidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,0,6">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ArchiveSessionCommand}"/>
    </Window.InputBindings>

    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- TitleBar Row -->
                <RowDefinition Height="40"/>
                <!-- Main Body Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. Custom TitleBar with Navigation Tabs & Window Control Buttons -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceContainerBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,20,0">
                        <Image Source="/app_icon.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="المحاسب الذكي" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" - v2.0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="🧮 حاسبة الضرب التتابعي"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=0}"
                                     Style="{StaticResource NavTabButtonStyle}"/>
                        <RadioButton Content="➕ الحاسبة القياسية"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=1}"
                                     Style="{StaticResource NavTabButtonStyle}"/>
                        <RadioButton Content="📂 إدارة وحفظ العمليات"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=2}"
                                     Style="{StaticResource NavTabButtonStyle}"/>
                        <RadioButton Content="⚙️ الإعدادات"
                                     IsChecked="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=3}"
                                     Style="{StaticResource NavTabButtonStyle}"/>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                        <Button Content="🗕" Click="MinimizeButton_Click" Style="{StaticResource WindowControlButtonStyle}" ToolTip="تصغير النافذة"/>
                        <Button Content="🗖" Click="MaximizeButton_Click" Style="{StaticResource WindowControlButtonStyle}" ToolTip="تكبير / استعادة النافذة"/>
                        <Button Content="✕" Click="CloseButton_Click" Style="{StaticResource CloseControlButtonStyle}" ToolTip="إغلاق التطبيق"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Main View Content switcher via SelectedTabIndex -->
            <Grid Grid.Row="1">
                
                <!-- TAB 0: MAIN CALCULATOR -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToVisibilityConverter.Instance}, ConverterParameter=0}" Margin="16">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0 (Right Side in RTL): Full Height Compact Operations Table -->
                        <ColumnDefinition Width="400"/>
                        <!-- Column 1: Spacing -->
                        <ColumnDefinition Width="16"/>
                        <!-- Column 2 (Left Side in RTL): Hero Inputs, Actions & Summary Cards -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RIGHT PANEL: Full-Height Data Table DataGrid -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header Banner -->
                            <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceContainerHighBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="جدول العمليات الحسابية" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}({0} عملية)}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- DataGrid (Compact Font & Full Height) -->
                            <DataGrid Grid.Row="1"
                                      x:Name="RecordsDataGrid"
                                      ItemsSource="{Binding Records}"
                                      SelectedItem="{Binding SelectedRecord}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource OutlineVariantBrush}"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                                      BorderThickness="0">

                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="{DynamicResource SurfaceContainerHighBrush}" BorderBrush="{DynamicResource OutlineBrush}">
                                        <MenuItem Header="✏️ تعديل الصف" Command="{Binding EditRecordCommand}" CommandParameter="{Binding SelectedRecord}" FontSize="13" Padding="10,5"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ حذف الصف" Command="{Binding DeleteRecordCommand}" CommandParameter="{Binding SelectedRecord}" Foreground="{DynamicResource ErrorBrush}" FontSize="13" Padding="10,5"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <!-- Id Column -->
                                    <DataGridTextColumn Header="المسلسل" Binding="{Binding FormattedId}" Width="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Number 1 Column -->
                                    <DataGridTextColumn Header="الرقم الأول" Binding="{Binding NumberOne, StringFormat={}{0:#,##0.##}}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Number 2 Column -->
                                    <DataGridTextColumn Header="الرقم الثاني" Binding="{Binding NumberTwo, StringFormat={}{0:#,##0.##}}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Result Column -->
                                    <DataGridTextColumn Header="الناتج" Binding="{Binding Result, StringFormat={}{0:#,##0.##}}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- LEFT PANEL: Session Name Bar + Hero Input Section + Summary Cards -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Session Control Bar -->
                            <RowDefinition Height="Auto"/> <!-- Compact Input Box (Current Operation) -->
                            <RowDefinition Height="*"/>    <!-- Expanded Main Total Results Spotlight Box -->
                        </Grid.RowDefinitions>

                        <!-- Session Controls Bar (Session Name Input, Save, History Dropdown & Theme) -->
                        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Label & Session Name Input -->
                                <TextBlock Grid.Column="0" Text="اسم العملية:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CurrentSessionName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernInputStyle}"
                                         ToolTip="اكتب اسماً مخصصاً للعملية أو اتركه فارغاً ليحفظ باسم تلقائي"
                                         Margin="0,0,12,0"/>

                                <!-- Save / Update Button -->
                                <Button Grid.Column="2"
                                        Content="💾 حفظ / أرشفة"
                                        Command="{Binding ArchiveSessionCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Margin="0,0,8,0"
                                        ToolTip="حفظ العملية الحالية وسجل العمليات في الأرشيف (تعديل الأصل دون تكرار)"/>

                                <!-- New Session Button -->
                                <Button Grid.Column="3"
                                        Content="➕ جديدة"
                                        Command="{Binding NewSessionCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,0,8,0"
                                        ToolTip="بدء عملية جديدة وتفريغ الجدول"/>

                                 <!-- Rich Formatted History Menu Dropdown (Today's operations only) -->
                                <Menu Grid.Column="4" Background="Transparent" VerticalAlignment="Center">
                                    <MenuItem Header="📜 سجل اليوم"
                                              ItemsSource="{Binding TodayHistorySessions}"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}">
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                    <Border Background="{DynamicResource TertiaryContainerBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Count, StringFormat={}{0} صفوف}" FontSize="11" Foreground="{DynamicResource TertiaryBrush}"/>
                                                    </Border>
                                                     <TextBlock Text="{Binding FormattedTotal, StringFormat={}{0} ج.م}" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Command" Value="{Binding DataContext.LoadSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Setter Property="CommandParameter" Value="{Binding}"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </Menu>
                            </Grid>
                        </Border>

                        <!-- Compact Current Operation Section -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.08" ShadowDepth="1"/>
                            </Border.Effect>

                            <Grid VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="500">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="العملية الحالية: " FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding EquationText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Main Input Field (Compact height & clean styling) -->
                                    <TextBox x:Name="MainInputTextBox"
                                             Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource HeroTextBoxStyle}"
                                             Height="44"
                                             FontSize="18"
                                             FlowDirection="LeftToRight"
                                             KeyDown="MainInputTextBox_KeyDown"
                                             Margin="0,0,0,6"/>

                                    <!-- Instant Calculation Display -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="الناتج: " FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding InstantResultText}" FontSize="32" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Enter للإضافة | Escape للحفظ والتجديد" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Spotlight Total Results Card (Main Hero Card - Expanded Size) -->
                        <Grid Grid.Row="2" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Enlarged Total Results Box -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SurfaceContainerHighBrush}"
                                    CornerRadius="16"
                                    Padding="24,20"
                                    BorderBrush="{DynamicResource SecondaryBrush}"
                                    BorderThickness="2.5"
                                    VerticalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="25" Color="#FF9F0A" Opacity="0.4" ShadowDepth="0"/>
                                </Border.Effect>
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title and Icon Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="🎯 إجمالي النواتج الكلي" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource SecondaryBrush}"/>
                                            <TextBlock Text="المجموع التراكمي لكافة نواتج عمليات الجدول" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="68" Height="68" CornerRadius="34" Background="{DynamicResource SecondaryContainerBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="💰" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Large Total Number Display -->
                                    <Viewbox Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxHeight="110">
                                        <TextBlock Text="{Binding Total, StringFormat={}{0:#,##0.##}}" FontSize="64" FontWeight="ExtraBold" Foreground="{DynamicResource SecondaryBrush}"/>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <!-- Count Card -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="16" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="عدد العمليات" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource TertiaryContainerBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontSize="36" FontWeight="ExtraBold" Foreground="{DynamicResource TertiaryBrush}"/>
                                        <Border Background="{DynamicResource TertiaryContainerBrush}" CornerRadius="6" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="عملية" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TertiaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- TAB 1: WINDOWS 11 STANDARD CALCULATOR -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToVisibilityConverter.Instance}, ConverterParameter=1}" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <views:StandardCalculatorControl x:Name="Win11CalculatorControl"/>
                </Grid>

                <!-- TAB 2: SESSIONS MANAGEMENT & SEARCH -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToVisibilityConverter.Instance}, ConverterParameter=2}" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filters Bar -->
                        <RowDefinition Height="*"/>    <!-- Sessions DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Top Filters & Search Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Text Search Box -->
                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernInputStyle}"
                                         Height="38"
                                         Padding="12,8"
                                         FontSize="13"/>
                                <TextBlock Text="🔍 ابحث باسم العملية، التاريخ، أو الناتج..."
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"
                                           Visibility="{Binding SearchQuery, Converter={x:Static converters:InverseStringToVisibilityConverter.Instance}}"/>
                            </Grid>

                            <!-- Date Quick Filters Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="الكل" Command="{Binding SetDateFilterCommand}" CommandParameter="All" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="📅 عمليات اليوم" Command="{Binding SetDateFilterCommand}" CommandParameter="Today" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="📅 هذا الأسبوع" Command="{Binding SetDateFilterCommand}" CommandParameter="Week" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="📅 هذا الشهر" Command="{Binding SetDateFilterCommand}" CommandParameter="Month" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Archived Sessions List DataGrid -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding FilteredHistorySessions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource OutlineVariantBrush}"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                                  BorderThickness="0">
                            
                            <DataGrid.Columns>
                                <!-- Session ID -->
                                <DataGridTextColumn Header="رقم الجلسة" Binding="{Binding Id}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Session Name -->
                                <DataGridTextColumn Header="اسم العملية" Binding="{Binding Name}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Created Date -->
                                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding FormattedDate}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Rows Count -->
                                <DataGridTextColumn Header="عدد الصفوف" Binding="{Binding Count}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Total Result -->
                                <DataGridTextColumn Header="إجمالي النواتج" Binding="{Binding FormattedTotal}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Actions Buttons -->
                                <DataGridTemplateColumn Header="الإجراءات" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="✏️ فتح وتعديل"
                                                        Command="{Binding DataContext.LoadSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                                        Padding="8,4"
                                                        Margin="0,0,6,0"
                                                        ToolTip="تحميل هذه العملية في الحاسبة الرئيسية لتعديل أصلها"/>
                                                <Button Content="🗑️ حذف"
                                                        Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Foreground="{DynamicResource ErrorBrush}"
                                                        Padding="8,4"
                                                        ToolTip="حذف الجلسة نهائياً من الأرشيف"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- TAB 3: SETTINGS -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={x:Static converters:TabIndexToVisibilityConverter.Instance}, ConverterParameter=3}" Margin="16">
                    <Grid.ColumnDefinitions>
                        <!-- Sidebar Sub-Tabs (Right Side in RTL) -->
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Sub-Tab Content View -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Sub-Tabs Navigation -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock Text="⚙️ الإعدادات العامة" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,8,8,16"/>
                            <RadioButton Content="🎨 الشكل والمظهر"
                                         IsChecked="{Binding SelectedSettingsSubTab, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=0}"
                                         Style="{StaticResource SettingsSidebarButtonStyle}"/>
                            <RadioButton Content="💾 حفظ وحذف البيانات"
                                         IsChecked="{Binding SelectedSettingsSubTab, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=1}"
                                         Style="{StaticResource SettingsSidebarButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings View Area -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="24">
                        <Grid>
                            <!-- SUB-TAB 0: Theme Selection (الشكل والمظهر) -->
                            <Grid Visibility="{Binding SelectedSettingsSubTab, Converter={x:Static converters:TabIndexToVisibilityConverter.Instance}, ConverterParameter=0}">
                                <StackPanel>
                                    <TextBlock Text="🎨 اختيار مظهر التطبيق (الثيمات)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="اختر اللون والمظهر المفضل للتطبيق من بين 5 ثيمات مميزة، جميع الألوان متناسقة وعالية التباين لضمان وضوح نصوص الشاشة والرسم البصري." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                    <UniformGrid Columns="3" Margin="0,0,0,10">
                                        <!-- Theme 1: Dark -->
                                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="16" Margin="6" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🌙 المظهر الداكن" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="ألوان غامقة مريحة للعين للملاحظات الليلية" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                                <Button Content="تطبيق الثيم الداكن"
                                                        Command="{Binding SelectThemeCommand}" CommandParameter="Dark"
                                                        Style="{StaticResource PrimaryActionButtonStyle}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Theme 2: Light -->
                                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="16" Margin="6" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="☀️ المظهر الفاتح" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="ألوان فاتحة وناصعة ومناسبة للنهار" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                                <Button Content="تطبيق الثيم الفاتح"
                                                        Command="{Binding SelectThemeCommand}" CommandParameter="Light"
                                                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Theme 3: Orange -->
                                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="16" Margin="6" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🟧 الثيم البرتقالي" FontSize="15" FontWeight="Bold" Foreground="#FF7A00" Margin="0,0,0,4"/>
                                                <TextBlock Text="ألوان برتقالية دافئة وجذابة عالية التباين" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                                <Button Content="تطبيق الثيم البرتقالي"
                                                        Command="{Binding SelectThemeCommand}" CommandParameter="Orange"
                                                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Theme 4: Red -->
                                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="16" Margin="6" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🟥 الثيم الأحمر" FontSize="15" FontWeight="Bold" Foreground="#FF3B30" Margin="0,0,0,4"/>
                                                <TextBlock Text="ألوان أحمر عنابي وراقية مع وضوح عالي" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                                <Button Content="تطبيق الثيم الأحمر"
                                                        Command="{Binding SelectThemeCommand}" CommandParameter="Red"
                                                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Theme 5: Brown -->
                                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="16" Margin="6" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🟫 الثيم البني" FontSize="15" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,4"/>
                                                <TextBlock Text="ألوان بنية وبرونزية كلاسيكية فاخرة" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                                <Button Content="تطبيق الثيم البني"
                                                        Command="{Binding SelectThemeCommand}" CommandParameter="Brown"
                                                        Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>

                            <!-- SUB-TAB 1: Data Storage & Auto Cleanup (حفظ وحذف البيانات) -->
                            <Grid Visibility="{Binding SelectedSettingsSubTab, Converter={x:Static converters:TabIndexToVisibilityConverter.Instance}, ConverterParameter=1}">
                                <StackPanel MaxWidth="650" HorizontalAlignment="Right">
                                    <TextBlock Text="💾 إعدادات حفظ وحذف البيانات" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="يمكنك التحكم في التعيين التلقائي للحفظ والتفريغ وإدارة مدة التخزين والاحتفاظ بسجلات العمليات." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                                    <!-- Option 1: Auto Save Checkbox -->
                                    <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="تفعيل الحفظ التلقائي للعمليات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="عند تفعيل هذا الخيار يتم حفظ وأرشفة عمليات الجدول تلقائياً في ذاكرة التخزين وفق بقية الإعدادات." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableAutoSave, Mode=TwoWay}" Command="{Binding ToggleAutoSaveCommand}" VerticalAlignment="Center" Cursor="Hand">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>
                                        </Grid>
                                    </Border>

                                    <!-- Option 2: Retention Period Selection -->
                                    <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,24" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="تحديد مدة الاحتفاظ بالبيانات والحذف التلقائي" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="سيتم حذف أي عملية قديمة تجاوزت المدة المحددة باليوم تلقائياً لضمان خفة سرعة التطبيق:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                            <WrapPanel>
                                                <Button Content="1 يوم" Command="{Binding SetAutoDeleteDaysCommand}" CommandParameter="1" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Content="2 يوم" Command="{Binding SetAutoDeleteDaysCommand}" CommandParameter="2" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Content="3 أيام" Command="{Binding SetAutoDeleteDaysCommand}" CommandParameter="3" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Content="7 أيام" Command="{Binding SetAutoDeleteDaysCommand}" CommandParameter="7" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Content="30 يوم" Command="{Binding SetAutoDeleteDaysCommand}" CommandParameter="30" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Content="90 يوم" Command="{Binding SetAutoDeleteDaysCommand}" CommandParameter="90" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8"/>
                                                <Button Content="∞ عدم الحذف التلقائي" Command="{Binding SetAutoDeleteDaysCommand}" CommandParameter="0" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,0,8,8"/>
                                            </WrapPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="المدة الحالية المحددة: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Settings.AutoDeleteDays, StringFormat={}{0} يوم}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Option 3: Clear Data Button -->
                                    <Border Background="{DynamicResource ErrorContainerBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="⚠️ تفريغ ومسح كافة البيانات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
                                                <TextBlock Text="حذف جميع الصفوف وسجل العمليات الحالية والمؤرشفة نهائياً وبدء سجل جديد." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🗑️ تفريغ البيانات الآن" Command="{Binding ClearAllDataCommand}" Style="{StaticResource ActionButtonStyle}" Foreground="{DynamicResource ErrorBrush}" Padding="14,8" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
