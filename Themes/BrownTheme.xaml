<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Color Palette (Brown Theme) -->
    <Color x:Key="WindowBackgroundColor">#171412</Color>
    <Color x:Key="SurfaceColor">#211C18</Color>
    <Color x:Key="SurfaceContainerColor">#2A241F</Color>
    <Color x:Key="SurfaceContainerHighColor">#383029</Color>
    <Color x:Key="SurfaceContainerHighestColor">#473D35</Color>
    
    <Color x:Key="TextPrimaryColor">#FAF5F0</Color>
    <Color x:Key="TextSecondaryColor">#E4D8CC</Color>
    <Color x:Key="TextMutedColor">#A69788</Color>
    
    <Color x:Key="OutlineColor">#54463A</Color>
    <Color x:Key="OutlineVariantColor">#3E332B</Color>
    
    <Color x:Key="PrimaryAccentColor">#D97706</Color>
    <Color x:Key="PrimaryLightColor">#F59E0B</Color>
    <Color x:Key="PrimaryContainerColor">#422006</Color>
    <Color x:Key="OnPrimaryContainerColor">#FEF3C7</Color>
    
    <Color x:Key="SecondaryColor">#F59E0B</Color>
    <Color x:Key="SecondaryContainerColor">#3A2500</Color>
    
    <Color x:Key="TertiaryColor">#34C759</Color>
    <Color x:Key="TertiaryContainerColor">#003816</Color>
    
    <Color x:Key="ErrorColor">#FF453A</Color>
    <Color x:Key="ErrorContainerColor">#5C1410</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />

    <!-- Control-specific Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#120F0D" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#54463A" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#D97706" />
    
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3E332B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A241F" />
    
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#383029" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#E4D8CC" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#332B25" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="#1F1A17" />
    <SolidColorBrush x:Key="DataGridSelectedRowBrush" Color="#422006" />
    
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#383029" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#473D35" />

</ResourceDictionary>
