<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Color Palette (Light Theme) -->
    <Color x:Key="WindowBackgroundColor">#F4F5F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerColor">#F0F2F5</Color>
    <Color x:Key="SurfaceContainerHighColor">#E4E7ED</Color>
    <Color x:Key="SurfaceContainerHighestColor">#D8DCE3</Color>
    
    <Color x:Key="TextPrimaryColor">#1A1C1E</Color>
    <Color x:Key="TextSecondaryColor">#44474E</Color>
    <Color x:Key="TextMutedColor">#74777F</Color>
    
    <Color x:Key="OutlineColor">#BFC7D5</Color>
    <Color x:Key="OutlineVariantColor">#E0E4EC</Color>
    
    <Color x:Key="PrimaryAccentColor">#005DB8</Color>
    <Color x:Key="PrimaryLightColor">#0A84FF</Color>
    <Color x:Key="PrimaryContainerColor">#D6E3FF</Color>
    <Color x:Key="OnPrimaryContainerColor">#001B3E</Color>
    
    <Color x:Key="SecondaryColor">#D97706</Color>
    <Color x:Key="SecondaryContainerColor">#FEF3C7</Color>
    
    <Color x:Key="TertiaryColor">#059669</Color>
    <Color x:Key="TertiaryContainerColor">#D1FAE5</Color>
    
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="ErrorContainerColor">#FEE2E2</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />

    <!-- Control-specific Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#BFC7D5" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#005DB8" />
    
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E4EC" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#E4E7ED" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#44474E" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#EAECEF" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="#F8F9FA" />
    <SolidColorBrush x:Key="DataGridSelectedRowBrush" Color="#D6E3FF" />
    
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#E4E7ED" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#D8DCE3" />

</ResourceDictionary>
