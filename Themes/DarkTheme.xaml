<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Color Palette (Dark Theme) -->
    <Color x:Key="WindowBackgroundColor">#131315</Color>
    <Color x:Key="SurfaceColor">#1B1B1D</Color>
    <Color x:Key="SurfaceContainerColor">#1F1F21</Color>
    <Color x:Key="SurfaceContainerHighColor">#2A2A2C</Color>
    <Color x:Key="SurfaceContainerHighestColor">#353437</Color>
    
    <Color x:Key="TextPrimaryColor">#E4E2E4</Color>
    <Color x:Key="TextSecondaryColor">#C0C6D6</Color>
    <Color x:Key="TextMutedColor">#8B91A0</Color>
    
    <Color x:Key="OutlineColor">#414754</Color>
    <Color x:Key="OutlineVariantColor">#2E333D</Color>
    
    <Color x:Key="PrimaryAccentColor">#0A84FF</Color>
    <Color x:Key="PrimaryLightColor">#AAC7FF</Color>
    <Color x:Key="PrimaryContainerColor">#1E3A5F</Color>
    <Color x:Key="OnPrimaryContainerColor">#D6E3FF</Color>
    
    <Color x:Key="SecondaryColor">#FF9F0A</Color>
    <Color x:Key="SecondaryContainerColor">#3A2800</Color>
    
    <Color x:Key="TertiaryColor">#34C759</Color>
    <Color x:Key="TertiaryContainerColor">#003816</Color>
    
    <Color x:Key="ErrorColor">#FF453A</Color>
    <Color x:Key="ErrorContainerColor">#5C1410</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />

    <!-- Control-specific Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E0E10" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#414754" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#0A84FF" />
    
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E333D" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F1F21" />
    
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#2A2A2C" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#C0C6D6" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#292A30" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="#171719" />
    <SolidColorBrush x:Key="DataGridSelectedRowBrush" Color="#1E3A5F" />
    
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#2A2A2C" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#353437" />

</ResourceDictionary>
